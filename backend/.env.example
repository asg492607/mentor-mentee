FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
CORS_ORIGINS=http://localhost:5500,http://localhost:3000,http://127.0.0.1:5500
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ==============================================================================
# Google Drive Recording Storage Configuration
# ==============================================================================
# Google Drive folder ID where meeting recordings will be stored
# (Extract from folder URL: https://drive.google.com/drive/folders/<FOLDER_ID>)
GOOGLE_DRIVE_FOLDER_ID=

# Google Service Account JSON key string (Recommended for backend server uploads)
# Paste the full JSON content or path to service account key with Google Drive API enabled
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Optional: Google Drive API Key
GOOGLE_DRIVE_API_KEY=
