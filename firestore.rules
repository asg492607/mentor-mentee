rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function approvedStudent() {
      return request.auth != null
        && request.auth.token.platform_claim_version == 2
        && request.auth.token.platform_approved == true
        && exists(/databases/$(database)/documents/students/$(request.auth.uid))
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.role == 'STUDENT'
        && request.auth.token.role == 'STUDENT'
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.status == 'approved'
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.isApproved == true;
    }

    function approvedFaculty() {
      return request.auth != null
        && request.auth.token.platform_claim_version == 2
        && request.auth.token.platform_approved == true
        && exists(/databases/$(database)/documents/faculty/$(request.auth.uid))
        && get(/databases/$(database)/documents/faculty/$(request.auth.uid)).data.role
          in ['FACULTY', 'MENTOR', 'HOD', 'DEAN', 'SECTION_HEAD', 'ADMIN']
        && request.auth.token.role == get(/databases/$(database)/documents/faculty/$(request.auth.uid)).data.role
        && get(/databases/$(database)/documents/faculty/$(request.auth.uid)).data.status == 'approved'
        && get(/databases/$(database)/documents/faculty/$(request.auth.uid)).data.isApproved == true;
    }

    function signedIn() {
      return approvedStudent() || approvedFaculty();
    }

    function uid() {
      return request.auth.uid;
    }

    function role() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return approvedFaculty()
        && role() == 'ADMIN'
        && request.auth.token.admin == true;
    }

    function currentDepartment() {
      let profile = get(/databases/$(database)/documents/faculty/$(uid())).data;
      return 'department' in profile ? profile.department : null;
    }

    function currentDepartmentId() {
      let profile = get(/databases/$(database)/documents/faculty/$(uid())).data;
      return 'departmentId' in profile ? profile.departmentId : null;
    }

    function isDean() {
      return signedIn() && role() == 'DEAN';
    }

    function isHod() {
      return signedIn() && role() == 'HOD';
    }

    function isTeachingStaff() {
      return approvedFaculty() && role() in ['FACULTY', 'MENTOR', 'HOD'];
    }

    function currentSchoolId() {
      let profile = get(/databases/$(database)/documents/faculty/$(uid())).data;
      return 'schoolId' in profile ? profile.schoolId : null;
    }

    function sameDepartmentData(data) {
      return (('departmentId' in data) && data.departmentId is string)
        ? (currentDepartmentId() is string && data.departmentId == currentDepartmentId())
        : (('department' in data) && data.department == currentDepartment()
          && ((('schoolId' in data) && currentSchoolId() is string && data.schoolId == currentSchoolId())
            || (( !('schoolId' in data) || data.schoolId == null) && !(currentSchoolId() is string)));
    }

    function mentorAssigned(student) {
      return (('mentorId' in student) && student.mentorId == uid())
        || (('secondaryMentorId' in student) && student.secondaryMentorId == uid())
        || ('mentorIds' in student && student.mentorIds is list && uid() in student.mentorIds);
    }

    function studentHasFaculty(student, facultyId) {
      return (('mentorId' in student) && student.mentorId == facultyId)
        || (('secondaryMentorId' in student) && student.secondaryMentorId == facultyId)
        || ('mentorIds' in student && student.mentorIds is list && facultyId in student.mentorIds);
    }

    function studentExists(studentId) {
      return studentId is string
        && exists(/databases/$(database)/documents/students/$(studentId));
    }

    function meetingParticipant(meeting) {
      return signedIn() && (
        meeting.mentorId == uid()
        || meeting.studentId == uid()
        || (meeting.studentId == 'ALL' && approvedStudent()
          && studentHasFaculty(get(/databases/$(database)/documents/students/$(uid())).data, meeting.mentorId))
        || ('participantIds' in meeting && meeting.participantIds is list && uid() in meeting.participantIds)
      );
    }

    function canReadMeeting(meeting) {
      return isAdmin() || isDean()
        || (isHod() && sameDepartmentData(meeting))
        || (isTeachingStaff() && meeting.mentorId == uid());
    }

    function canCreateMeeting(meeting) {
      return isAdmin()
        || (isTeachingStaff() && meeting.mentorId == uid()
          && (meeting.studentId == 'ALL' || mentorsStudent(meeting.studentId)))
        || (approvedStudent() && meeting.studentId == uid()
          && studentHasFaculty(get(/databases/$(database)/documents/students/$(uid())).data, meeting.mentorId));
    }

    function canStudentUpdateMeeting(meetingId) {
      return approvedStudent() && resource.data.studentId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'studentAcknowledged', 'acknowledgedAt', 'acknowledgedByStudentId',
          'studentFeedback', 'studentRating', 'updatedAt'
        ])
        && (request.resource.data.status == resource.data.status
          || (request.resource.data.status == 'CANCELLED'
            && resource.data.status in ['REQUESTED', 'APPROVED']))
        && (!('acknowledgedByStudentId' in request.resource.data)
          || request.resource.data.acknowledgedByStudentId == uid())
        && (!('studentRating' in request.resource.data)
          || (request.resource.data.studentRating is number
            && request.resource.data.studentRating >= 1
            && request.resource.data.studentRating <= 5));
    }

    function issueVisible(issue) {
      return isAdmin() || isDean()
        || (approvedStudent() && issue.studentId == uid())
        || (isTeachingStaff() && issue.mentorId == uid())
        || (isHod() && sameDepartmentData(issue))
        || (signedIn() && role() == 'SECTION_HEAD' && issue.escalationLevel == currentDepartment());
    }

    function issueEditable(issue) {
      return isAdmin()
        || (isTeachingStaff() && issue.mentorId == uid() && issue.escalationLevel == 'MENTOR'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'resolution', 'actionTaken', 'escalationLevel', 'escalationHistory',
            'resolvedByRole', 'updatedAt'
          ]))
        || (isHod() && sameDepartmentData(issue)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'resolution', 'actionTaken', 'escalationLevel', 'escalationHistory',
            'resolvedByRole', 'updatedAt'
          ]))
        || (signedIn() && role() == 'SECTION_HEAD'
          && issue.escalationLevel == currentDepartment()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'resolution', 'actionTaken', 'escalationLevel', 'escalationHistory',
            'resolvedByRole', 'updatedAt'
          ]))
        || (isDean() && issue.escalationLevel == 'DEAN'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'resolution', 'actionTaken', 'escalationLevel', 'escalationHistory',
            'resolvedByRole', 'updatedAt'
          ]));
    }

    function issueCreateHasSafeFields() {
      return request.resource.data.keys().hasOnly([
        'studentId', 'studentName', 'studentEnrollment', 'studentEnrollmentNumber',
        'mentorId', 'mentorName', 'department', 'departmentId', 'schoolId', 'schoolName',
        'title', 'description', 'category', 'priority', 'status', 'escalationLevel',
        'escalationHistory', 'raisedBy', 'raisedByName', 'raisedByRole', 'createdAt', 'updatedAt'
      ])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
        && request.resource.data.description is string && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 10000
        && request.resource.data.category is string && request.resource.data.category.size() <= 100
        && request.resource.data.priority in ['LOW', 'MEDIUM', 'HIGH', 'CRITICAL']
        && request.resource.data.escalationHistory is list
        && request.resource.data.escalationHistory.size() <= 20;
    }

    function issueStudentMatchesDepartment(issue) {
      return issue.studentId is string && studentExists(issue.studentId)
        && sameDepartmentData(get(/databases/$(database)/documents/students/$(issue.studentId)).data)
        && (('departmentId' in issue)
          ? get(/databases/$(database)/documents/students/$(issue.studentId)).data.departmentId == issue.departmentId
          : get(/databases/$(database)/documents/students/$(issue.studentId)).data.department == issue.department);
    }

    function actionItemVisible(item) {
      return isAdmin() || isDean()
        || (approvedStudent() && item.studentId == uid())
        || (isTeachingStaff() && (item.mentorId == uid() || mentorsStudent(item.studentId)));
    }

    function canNotifyIssueParticipant(targetId, notification) {
      return ('relatedId' in notification) && notification.relatedId is string
        && exists(/databases/$(database)/documents/issues/$(notification.relatedId))
        && notification.type in ['ISSUE_ESCALATED', 'ISSUE_RESOLVED', 'ISSUE_RAISED']
        && (
          (isTeachingStaff() && notification.type == 'ISSUE_ESCALATED'
            && get(/databases/$(database)/documents/issues/$(notification.relatedId)).data.mentorId == uid()
            && sameDepartmentData(get(/databases/$(database)/documents/issues/$(notification.relatedId)).data)
            && exists(/databases/$(database)/documents/faculty/$(targetId))
            && ((get(/databases/$(database)/documents/faculty/$(targetId)).data.role == 'HOD'
                && get(/databases/$(database)/documents/issues/$(notification.relatedId)).data.escalationLevel == 'HOD'
                && sameDepartmentData(get(/databases/$(database)/documents/faculty/$(targetId)).data))
              || (get(/databases/$(database)/documents/faculty/$(targetId)).data.role == 'SECTION_HEAD'
                && get(/databases/$(database)/documents/faculty/$(targetId)).data.department
                  == get(/databases/$(database)/documents/issues/$(notification.relatedId)).data.escalationLevel)))
          || (isHod() && sameDepartmentData(get(/databases/$(database)/documents/issues/$(notification.relatedId)).data)
            && get(/databases/$(database)/documents/issues/$(notification.relatedId)).data.raisedBy == uid()
            && get(/databases/$(database)/documents/issues/$(notification.relatedId)).data.escalationLevel == 'DEAN'
            && exists(/databases/$(database)/documents/faculty/$(targetId))
            && get(/databases/$(database)/documents/faculty/$(targetId)).data.role == 'DEAN'
            && notification.type == 'ISSUE_ESCALATED')
          || (isHod() && sameDepartmentData(get(/databases/$(database)/documents/issues/$(notification.relatedId)).data)
            && get(/databases/$(database)/documents/issues/$(notification.relatedId)).data.mentorId == targetId
            && notification.type in ['ISSUE_RESOLVED', 'ISSUE_RAISED'])
        );
    }

    function canNotifyUser(targetId, notification) {
      return isAdmin() || isDean()
        || (isTeachingStaff() && studentExists(targetId)
          && mentorAssigned(get(/databases/$(database)/documents/students/$(targetId)).data))
        || (isHod() && studentExists(targetId)
          && sameDepartmentData(get(/databases/$(database)/documents/students/$(targetId)).data))
        || (approvedStudent() && exists(/databases/$(database)/documents/faculty/$(targetId))
          && studentHasFaculty(get(/databases/$(database)/documents/students/$(uid())).data, targetId))
        || canNotifyIssueParticipant(targetId, notification);
    }

    function chatParticipant(chat) {
      return signedIn() && (
        chat.studentId == uid() || chat.mentorId == uid()
        || ('studentIds' in chat && chat.studentIds is list && uid() in chat.studentIds)
        || ('participantIds' in chat && chat.participantIds is list && uid() in chat.participantIds)
      );
    }

    function canCreateChat(chat) {
      return (isTeachingStaff() && chat.mentorId == uid()
          && (chat.isGroup == true || mentorsStudent(chat.studentId)))
        || (approvedStudent() && chat.studentId == uid()
          && studentHasFaculty(get(/databases/$(database)/documents/students/$(uid())).data, chat.mentorId));
    }

    function currentProfileName() {
      return role() == 'STUDENT'
        ? get(/databases/$(database)/documents/students/$(uid())).data.name
        : get(/databases/$(database)/documents/faculty/$(uid())).data.name;
    }

    function canReadStudent(studentId) {
      return isAdmin() || isDean() || isAdmissionCell()
        || (approvedStudent() && studentId == uid())
        || (isHod() && sameDepartmentData(resource.data))
        || (isTeachingStaff() && (
          mentorAssigned(resource.data)
          || ((!('mentorId' in resource.data) || resource.data.mentorId == null)
            && (!('secondaryMentorId' in resource.data) || resource.data.secondaryMentorId == null)
            && sameDepartmentData(resource.data))
        ));
    }

    function canSelfAssignStudent() {
      return isTeachingStaff() && role() in ['FACULTY', 'MENTOR']
        && sameDepartmentData(resource.data)
        && (!('mentorId' in resource.data) || resource.data.mentorId == null)
        && request.resource.data.mentorId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'mentorId', 'secondaryMentorId', 'mentorIds', 'allocatedBy', 'allocatedAt',
          'allocationType', 'updatedAt'
        ]);
    }

    function canUpdateStudentPlacement() {
      return isHod()
        && sameDepartmentData(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'class', 'classId', 'department', 'departmentId', 'schoolId', 'schoolName',
          'course', 'year', 'yearLabel', 'durationYears', 'mentorId', 'secondaryMentorId',
          'mentorIds', 'allocatedBy', 'allocatedAt', 'allocationType', 'reassignmentHistory', 'updatedAt'
        ]);
    }

    function canUpdateStudentProfile(studentId) {
      return approvedStudent() && studentId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'interests', 'skills', 'careerGoal', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
    }

    function verifiedBookletPhone(fieldName, phoneValue) {
      let receiptPath = /databases/$(database)/documents/verified_phone_numbers/$(uid() + '_booklet_' + fieldName);
      return phoneValue == null || phoneValue == ''
        || (exists(receiptPath)
          && get(receiptPath).data.userId == uid()
          && get(receiptPath).data.phone == phoneValue);
    }

    function bookletPhonesVerifiedOnCreate() {
      let personal = request.resource.data.get('personal', {});
      return verifiedBookletPhone('fatherPhoneO', personal.get('fatherPhoneO', ''))
        && verifiedBookletPhone('fatherPhoneR', personal.get('fatherPhoneR', ''))
        && verifiedBookletPhone('fatherPhoneM', personal.get('fatherPhoneM', ''))
        && verifiedBookletPhone('motherPhoneO', personal.get('motherPhoneO', ''))
        && verifiedBookletPhone('motherPhoneR', personal.get('motherPhoneR', ''))
        && verifiedBookletPhone('motherPhoneM', personal.get('motherPhoneM', ''))
        && verifiedBookletPhone('guardianPhone', personal.get('guardianPhone', ''));
    }

    function bookletPhonesUnchangedOrVerified() {
      let oldPersonal = resource.data.get('personal', {});
      let newPersonal = request.resource.data.get('personal', {});
      return (oldPersonal.get('fatherPhoneO', '') == newPersonal.get('fatherPhoneO', '') || verifiedBookletPhone('fatherPhoneO', newPersonal.get('fatherPhoneO', '')))
        && (oldPersonal.get('fatherPhoneR', '') == newPersonal.get('fatherPhoneR', '') || verifiedBookletPhone('fatherPhoneR', newPersonal.get('fatherPhoneR', '')))
        && (oldPersonal.get('fatherPhoneM', '') == newPersonal.get('fatherPhoneM', '') || verifiedBookletPhone('fatherPhoneM', newPersonal.get('fatherPhoneM', '')))
        && (oldPersonal.get('motherPhoneO', '') == newPersonal.get('motherPhoneO', '') || verifiedBookletPhone('motherPhoneO', newPersonal.get('motherPhoneO', '')))
        && (oldPersonal.get('motherPhoneR', '') == newPersonal.get('motherPhoneR', '') || verifiedBookletPhone('motherPhoneR', newPersonal.get('motherPhoneR', '')))
        && (oldPersonal.get('motherPhoneM', '') == newPersonal.get('motherPhoneM', '') || verifiedBookletPhone('motherPhoneM', newPersonal.get('motherPhoneM', '')))
        && (oldPersonal.get('guardianPhone', '') == newPersonal.get('guardianPhone', '') || verifiedBookletPhone('guardianPhone', newPersonal.get('guardianPhone', '')));
    }

    function studentOwnsClass(classId) {
      return approvedStudent()
        && ('classId' in get(/databases/$(database)/documents/students/$(uid())).data)
        && get(/databases/$(database)/documents/students/$(uid())).data.classId == classId;
    }

    function isAdmissionCell() {
      return signedIn() && role() == 'SECTION_HEAD' && currentDepartment() == 'Admission Cell';
    }

    function mentorsStudent(studentId) {
      return studentExists(studentId)
        && mentorAssigned(get(/databases/$(database)/documents/students/$(studentId)).data);
    }

    // Students collection
    match /students/{studentId} {
      allow read: if signedIn() && canReadStudent(studentId);
      allow create: if isAdmin() || isAdmissionCell();
      allow update: if isAdmin()
        || canUpdateStudentProfile(studentId)
        || canUpdateStudentPlacement()
        || canSelfAssignStudent();
      allow delete: if isAdmin();
    }

    // Faculty collection
    match /faculty/{facultyId} {
      allow read: if signedIn() && (
        isAdmin() || isDean() || facultyId == uid()
        || (isHod() && sameDepartmentData(resource.data))
        || (approvedStudent() && exists(/databases/$(database)/documents/students/$(uid()))
          && studentHasFaculty(get(/databases/$(database)/documents/students/$(uid())).data, facultyId))
        || (resource.data.role == 'DEAN' && resource.data.status == 'approved' && resource.data.isApproved == true)
      );
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isHod() && sameDepartmentData(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignedStudentCount', 'updatedAt'])
          && 'assignedStudentCount' in resource.data
          && request.resource.data.assignedStudentCount >= 0
          && (request.resource.data.assignedStudentCount == resource.data.assignedStudentCount + 1
            || request.resource.data.assignedStudentCount == resource.data.assignedStudentCount - 1))
        || (isTeachingStaff() && facultyId == uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignedStudentCount', 'updatedAt'])
          && 'assignedStudentCount' in resource.data
          && request.resource.data.assignedStudentCount >= 0
          && (request.resource.data.assignedStudentCount == resource.data.assignedStudentCount + 1
            || request.resource.data.assignedStudentCount == resource.data.assignedStudentCount - 1));
    }

    // Meetings collection and subcollections
    match /meetings/{meetingId} {
      allow read: if signedIn() && canReadMeeting(resource.data);
      allow create: if canCreateMeeting(request.resource.data);
      allow update: if isAdmin()
        || (isTeachingStaff() && resource.data.mentorId == uid())
        || canStudentUpdateMeeting(meetingId);
      allow delete: if isAdmin() || (isTeachingStaff() && resource.data.mentorId == uid());

      match /signaling/{docId} {
        allow read, write: if meetingParticipant(get(/databases/$(database)/documents/meetings/$(meetingId)).data);
      }

      match /controls/{docId} {
        allow read, write: if meetingParticipant(get(/databases/$(database)/documents/meetings/$(meetingId)).data);
      }
    }

    // Backend-only meeting details
    match /meeting_private/{meetingId} {
      allow read, write: if false;
    }

    // Issues & Grievances
    match /issues/{issueId} {
      // Student issue views go through the API sanitizer so internal notes cannot
      // be exposed by newly added Firestore fields.
      allow read: if signedIn() && issueVisible(resource.data)
        && !(approvedStudent() && resource.data.studentId == uid());
      allow create: if isAdmin()
        || (isHod() && issueCreateHasSafeFields()
          && request.resource.data.raisedBy == uid()
          && request.resource.data.raisedByRole == 'HOD'
          && sameDepartmentData(request.resource.data)
          && (request.resource.data.studentId == null || issueStudentMatchesDepartment(request.resource.data))
          && request.resource.data.status in ['OPEN', 'ESCALATED']
          && (request.resource.data.status != 'ESCALATED' || request.resource.data.escalationLevel == 'DEAN'))
        || (isTeachingStaff() && issueCreateHasSafeFields()
          && request.resource.data.raisedBy == uid()
          && request.resource.data.raisedByRole in ['FACULTY', 'MENTOR', 'HOD']
          && request.resource.data.mentorId == uid()
          && mentorsStudent(request.resource.data.studentId)
          && issueStudentMatchesDepartment(request.resource.data)
          && sameDepartmentData(request.resource.data)
          && request.resource.data.status in ['OPEN', 'ESCALATED']
          && request.resource.data.escalationLevel is string
          && request.resource.data.escalationLevel != 'DEAN');
      allow update: if issueEditable(resource.data);
      allow delete: if isAdmin();
    }

    // Tasks & Action Items
    match /action_items/{itemId} {
      allow read: if signedIn() && actionItemVisible(resource.data);
      allow create: if isAdmin() || (isTeachingStaff()
        && request.resource.data.mentorId == uid()
        && mentorsStudent(request.resource.data.studentId));
      allow update: if isAdmin()
        || (approvedStudent() && resource.data.studentId == uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'progress', 'updatedAt'])
          && request.resource.data.progress is number
          && request.resource.data.progress >= 0 && request.resource.data.progress <= 100);
      allow delete: if isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == uid();
      allow create: if signedIn() && canNotifyUser(request.resource.data.userId, request.resource.data)
        && request.resource.data.isRead == false;
      allow update: if signedIn() && resource.data.userId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        && request.resource.data.isRead is bool;
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == uid());
    }

    // Chats & Messages
    match /chats/{chatId} {
      allow read: if chatParticipant(resource.data);
      allow create: if canCreateChat(request.resource.data);
      allow update: if chatParticipant(resource.data)
        && ((isTeachingStaff() && resource.data.mentorId == uid() && resource.data.isGroup == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'mentorName', 'studentIds', 'participantIds', 'updatedAt', 'lastMessage', 'lastSenderName'
          ]))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastMessage', 'lastSenderName', 'updatedAt'
          ])
          && (!('lastSenderName' in request.resource.data) || request.resource.data.lastSenderName == currentProfileName())));
      allow delete: if isAdmin() || (isTeachingStaff() && resource.data.mentorId == uid());

      match /messages/{messageId} {
        function parentChat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        allow read: if chatParticipant(parentChat());
        allow create: if chatParticipant(parentChat())
          && request.resource.data.senderId == uid()
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 5000
          && (!('senderName' in request.resource.data) || request.resource.data.senderName == currentProfileName())
          && (!('senderRole' in request.resource.data) || request.resource.data.senderRole == role());
        allow update, delete: if isAdmin();
      }
    }

    // Audit logs
    match /audit_logs/{logId} {
      allow read, write: if false;
    }

    // Security events (Backend Admin SDK only)
    match /security_events/{eventId} {
      allow read, write: if false;
    }

    // Departments
    match /departments/{departmentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Classes
    match /classes/{classId} {
      allow read: if signedIn() && (
        isAdmin() || isDean() || isAdmissionCell()
        || (isHod() && sameDepartmentData(resource.data))
        || studentOwnsClass(classId)
      );
      allow create: if isAdmin() || (isHod() && sameDepartmentData(request.resource.data));
      allow update: if isAdmin()
        || (isHod() && sameDepartmentData(resource.data)
          && sameDepartmentData(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['className', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // Settings
    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if isAdmin() || (settingId == 'academics' && isAdmissionCell());
    }

    // Mentorship Booklets
    match /booklets/{studentId} {
      allow read: if signedIn() && (
        isAdmin() || isDean()
        || (approvedStudent() && studentId == uid())
        || (isTeachingStaff() && mentorsStudent(studentId))
      );
      allow create: if isAdmin()
        || (approvedStudent() && studentId == uid() && bookletPhonesVerifiedOnCreate())
        || (isTeachingStaff() && mentorsStudent(studentId) && bookletPhonesVerifiedOnCreate());
      allow update: if isAdmin()
        || ((approvedStudent() && studentId == uid())
          && bookletPhonesUnchangedOrVerified())
        || (isTeachingStaff() && mentorsStudent(studentId)
          && bookletPhonesUnchangedOrVerified());
      allow delete: if isAdmin();
    }

    match /verified_phone_numbers/{receiptId} {
      allow read, write: if false;
    }

    // Web Issues / Feedback
    match /web_issues/{issueId} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.reporterId == uid();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // Mentor availability
    match /mentor_availability/{mentorId} {
      allow read: if signedIn();
      allow create: if isTeachingStaff() && mentorId == uid()
        && request.resource.data.mentorId == uid();
      allow update: if isTeachingStaff() && mentorId == uid()
        && request.resource.data.mentorId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'mentorId', 'activeDays', 'startTime', 'endTime', 'slotDuration',
          'bufferMinutes', 'maxDailyMeets', 'locationMode', 'updatedAt'
        ]);
      allow delete: if isAdmin() || (isTeachingStaff() && mentorId == uid());
    }

    // Academic records are visible to the student, their assigned mentor, and the relevant office.
    match /academic_results/{resultId} {
      allow read: if signedIn() && (
        resource.data.studentId == uid() || isAdmin() || isDean()
        || (isHod() && sameDepartmentData(resource.data))
        || mentorsStudent(resource.data.studentId)
      );
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Fee ledgers and payment receipts are backend-only. The Admissions API
    // enforces student self-service and office roles before returning records.
    match /student_finances/{studentId} {
      allow read, write: if false;
    }

    match /student_fee_payments/{paymentId} {
      allow read, write: if false;
    }

    match /attendance_records/{recordId} {
      allow read: if signedIn() && (
        resource.data.studentId == uid() || isAdmin() || isDean()
        || (isHod() && sameDepartmentData(resource.data))
        || mentorsStudent(resource.data.studentId)
      );
      allow create, update, delete: if isAdmin();
    }

    match /attendance_sessions/{sessionId} {
      allow read: if signedIn() && (
        isAdmin() || isDean() || (isHod() && sameDepartmentData(resource.data))
      );
      allow create, update, delete: if isAdmin();
    }

    // Mail queue
    match /mail/{mailId} {
      allow read, write: if false;
    }
  }
}
