rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function role() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return signedIn() && (request.auth.token.admin == true || role() == 'ADMIN');
    }

    function currentDepartment() {
      return get(/databases/$(database)/documents/faculty/$(uid())).data.department;
    }

    function isAdmissionCell() {
      return signedIn() && role() == 'SECTION_HEAD' && currentDepartment() == 'Admission Cell';
    }

    function isExamSection() {
      return signedIn() && role() == 'SECTION_HEAD' && currentDepartment() == 'Exam Section';
    }

    function isAssignedClassTeacher(classId) {
      return signedIn() && classId is string
        && get(/databases/$(database)/documents/classes/$(classId)).data.classTeacherId == uid();
    }

    function mentorsStudent(studentId) {
      let student = get(/databases/$(database)/documents/students/$(studentId)).data;
      return student.mentorId == uid() || (student.mentorIds is list && uid() in student.mentorIds);
    }

    // Students collection
    match /students/{studentId} {
      allow read, write: if signedIn();
    }

    // Faculty collection
    match /faculty/{facultyId} {
      allow read, write: if signedIn();
    }

    // Meetings collection and subcollections
    match /meetings/{meetingId} {
      allow read, write: if signedIn();

      match /signaling/{docId} {
        allow read, write: if signedIn();
      }

      match /controls/{docId} {
        allow read, write: if signedIn();
      }
    }

    // Backend-only meeting details
    match /meeting_private/{meetingId} {
      allow read, write: if false;
    }

    // Issues & Grievances
    match /issues/{issueId} {
      allow read, write: if signedIn();
    }

    // Tasks & Action Items
    match /action_items/{itemId} {
      allow read, write: if signedIn();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if signedIn();
    }

    // Chats & Messages
    match /chats/{chatId} {
      allow read, write: if signedIn();

      match /messages/{messageId} {
        allow read, write: if signedIn();
      }
    }

    // Audit logs
    match /audit_logs/{logId} {
      allow read, write: if signedIn();
    }

    // Security events (Backend Admin SDK only)
    match /security_events/{eventId} {
      allow read, write: if false;
    }

    // Departments
    match /departments/{departmentId} {
      allow read, write: if signedIn();
    }

    // Classes
    match /classes/{classId} {
      allow read, write: if signedIn();
    }

    // Settings
    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if signedIn() && settingId != 'academics' || isAdmin() || isAdmissionCell();
    }

    // Mentorship Booklets
    match /booklets/{studentId} {
      allow read, write: if signedIn();
    }

    // Web Issues / Feedback
    match /web_issues/{issueId} {
      allow read, write: if signedIn();
    }

    // Mentor availability
    match /mentor_availability/{mentorId} {
      allow read, write: if signedIn();
    }

    // Academic records are visible to the student, their assigned mentor, and the relevant office.
    match /academic_results/{resultId} {
      allow read: if signedIn() && (
        resource.data.studentId == uid() || isAdmin() || role() == 'DEAN' || role() == 'HOD'
        || isExamSection() || mentorsStudent(resource.data.studentId)
      );
      allow create, update: if isAdmin() || isExamSection();
      allow delete: if isAdmin();
    }

    match /attendance_records/{recordId} {
      allow read: if signedIn() && (
        resource.data.studentId == uid() || isAdmin() || role() == 'DEAN' || role() == 'HOD'
        || isAssignedClassTeacher(resource.data.classId) || mentorsStudent(resource.data.studentId)
      );
      allow create, update: if isAdmin() || isAssignedClassTeacher(request.resource.data.classId);
      allow delete: if isAdmin() || isAssignedClassTeacher(resource.data.classId);
    }

    match /attendance_sessions/{sessionId} {
      allow read: if signedIn() && (
        isAdmin() || role() == 'DEAN' || role() == 'HOD'
        || isAssignedClassTeacher(resource.data.classId)
      );
      allow create, update: if isAdmin() || isAssignedClassTeacher(request.resource.data.classId);
      allow delete: if isAdmin() || isAssignedClassTeacher(resource.data.classId);
    }

    // Mail queue
    match /mail/{mailId} {
      allow read, write: if false;
    }
  }
}
