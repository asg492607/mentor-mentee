rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Students collection
    match /students/{studentId} {
      allow read, write: if signedIn();
    }

    // Faculty collection
    match /faculty/{facultyId} {
      allow read, write: if signedIn();
    }

    // Meetings collection and subcollections
    match /meetings/{meetingId} {
      allow read, write: if signedIn();

      match /signaling/{docId} {
        allow read, write: if signedIn();
      }

      match /controls/{docId} {
        allow read, write: if signedIn();
      }
    }

    // Backend-only meeting details
    match /meeting_private/{meetingId} {
      allow read, write: if false;
    }

    // Issues & Grievances
    match /issues/{issueId} {
      allow read, write: if signedIn();
    }

    // Tasks & Action Items
    match /action_items/{itemId} {
      allow read, write: if signedIn();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if signedIn();
    }

    // Chats & Messages
    match /chats/{chatId} {
      allow read, write: if signedIn();

      match /messages/{messageId} {
        allow read, write: if signedIn();
      }
    }

    // Audit logs
    match /audit_logs/{logId} {
      allow read, write: if signedIn();
    }

    // Security events (Backend Admin SDK only)
    match /security_events/{eventId} {
      allow read, write: if false;
    }

    // Departments
    match /departments/{departmentId} {
      allow read, write: if signedIn();
    }

    // Classes
    match /classes/{classId} {
      allow read, write: if signedIn();
    }

    // Settings
    match /settings/{settingId} {
      allow read, write: if signedIn();
    }

    // Mentorship Booklets
    match /booklets/{studentId} {
      allow read, write: if signedIn();
    }

    // Web Issues / Feedback
    match /web_issues/{issueId} {
      allow read, write: if signedIn();
    }

    // Mentor availability
    match /mentor_availability/{mentorId} {
      allow read, write: if signedIn();
    }

    // Mail queue
    match /mail/{mailId} {
      allow read, write: if false;
    }
  }
}
